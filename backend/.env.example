# ========================================================
# StayNest - Environment Variables Template
# ========================================================

# --- FASTAPI BACKEND CONFIGURATION ---
PROJECT_NAME="StayNest API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- DATABASE (PostgreSQL / Supabase) ---
# Format: postgresql+psycopg://username:password@localhost:5432/staynest_db
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/staynest_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- SUPABASE AUTH & STORAGE ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- RAZORPAY PAYMENT GATEWAY ---
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# --- EMAIL (Resend) ---
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="support@staynest.com"

# --- OPENAI (AI Complaint Triage) ---
OPENAI_API_KEY="sk-your-openai-api-key"

# --- FRONTEND CLIENT ---
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
